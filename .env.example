# Ce projet n'a PAS de .env propre : .env est un lien symbolique vers le fichier
# partagé par tous les serveurs de jeu :
#   ln -sf ${HOME}/volumes/secrets/steam-account.env ${HOME}/projets/space-engineers/.env
#
# Variables de ce fichier partagé réellement utilisées par docker-compose.yml
# (les mots de passe/compte Steam qu'il contient ne sont PAS transmis au conteneur) :

# Fuseau horaire
TZ=Europe/Paris

# Propriétaire des volumes (sur l'hôte : id -u / id -g)
PUID=1000
PGID=1000

# Port de jeu UDP (même numéro hôte/conteneur, recopié dans <ServerPort> du .cfg).
# Le modifier puis : docker compose up -d. Défaut Keen : 27016.
jeux1=7777
